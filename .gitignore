# --- Environment and caches --------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.claude/

# --- Data: not redistributed -------------------------------------------------
# The images belong to the Web Gallery of Art; the catalogue is provided by the school.
# Only the notice and the list of selected paintings are versioned (see data/README.md).
data/**
!data/**/
!data/README.md
!data/datasets/summary.json
!data/datasets/*/metadata.csv

# --- Training runs: only the light files are versioned ------------------------
# (configuration, curves, scores). Checkpoints (1.5 GB) and image grids stay local;
# the selected generators are in models/.
runs/**
!runs/**/
!runs/**/config.json
!runs/**/eval.csv
!runs/**/history.csv

# --- Outputs that can be regenerated ------------------------------------------
# The figures (105 MB) are reproduced by the notebooks, which already embed them.
reports/figures/
reports/optuna/*.db
reports/optuna/*.log
outputs/
*.part
*.tmp

# --- Course material from the school (not redistributed) ----------------------
docs/GANisme.docx.pdf
docs/HowTo_TraitementImages_GAN_M2.pdf

# --- Personal working notes ---------------------------------------------------
# Remove these lines to publish them.
docs/how-to-1609.md
docs/suivi-projet.md
docs/cahier-des-charges-presentation.md
