# --- Environnement et caches -------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.claude/

# --- Données : non redistribuées ---------------------------------------------
# Les images appartiennent à la Web Gallery of Art ; le catalogue est fourni par l'école.
# On ne versionne que la notice et la liste des peintures retenues (voir data/README.md).
data/**
!data/**/
!data/README.md
!data/datasets/summary.json
!data/datasets/*/metadata.csv

# --- Entraînements : seuls les fichiers légers sont versionnés -----------------
# (configuration, courbes, scores). Les checkpoints (1,5 Go) et les grilles d'images restent en local ;
# les générateurs retenus sont dans models/.
runs/**
!runs/**/
!runs/**/config.json
!runs/**/eval.csv
!runs/**/history.csv

# --- Sorties régénérables ----------------------------------------------------
# Les figures (105 Mo) sont reproduites par les notebooks, qui les contiennent déjà.
reports/figures/
reports/optuna/*.db
reports/optuna/*.log
outputs/
*.part
*.tmp

# --- Supports de cours de l'école (non redistribués) ---------------------------
docs/GANisme.docx.pdf
docs/HowTo_TraitementImages_GAN_M2.pdf

# --- Notes de travail personnelles -------------------------------------------
# Retirer ces lignes pour les publier.
docs/how-to-1609.md
docs/suivi-projet.md
docs/cahier-des-charges-presentation.md
